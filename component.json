  "version": 1,
  "name": "lib-dynamic-loader",
  "kind": "library",
  "tests": [
    [
      "sh",
      "sdk/toolchain/scripts/check-dynamic-loader.sh"
    ]
  ],
  "artifacts": [
    {
      "source": "{sdk}/lib64/ld-hyper-{arch}.so",
      "destination": "lib64/ld-hyper-{arch}.so",
      "mode": "0755",
      "profiles": [
        "system",
        "development"
      ],
      "environment": "system"
    }
  ],
  "build": {
    "actions": {
      "all": [
        [
          "make",
          "-C",
          "{workspace}",
          "sdk"
        ]
      ],
      "build": [
        [
          "make",
          "-C",
          "{workspace}",
          "sdk"
        ]
      ]
    }
  }
}
